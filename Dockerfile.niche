FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-niche.txt .
RUN pip install --no-cache-dir -r requirements-niche.txt
COPY config.py .
COPY core ./core
COPY webapp/__init__.py webapp/database.py webapp/niche_store.py webapp/fly_niche_oneshot.py ./webapp/
CMD ["python", "-m", "webapp.fly_niche_oneshot"]
